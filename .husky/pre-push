#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run type check, lint check, format check, and tests before push
echo "🔍 Running pre-push checks..."

echo "📝 Type checking..."
npm run type-check || {
  echo "❌ Type check failed. Please fix type errors before pushing."
  exit 1
}

echo "🔎 Linting..."
npm run lint:check || {
  echo "❌ Lint check failed. Please fix linting errors before pushing."
  exit 1
}

echo "💅 Formatting check..."
npm run format:check || {
  echo "❌ Format check failed. Please run 'npm run format' to fix formatting issues."
  exit 1
}

echo "✅ All pre-push checks passed!"

